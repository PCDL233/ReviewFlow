    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-review/core": "workspace:*",
    "@ai-review/db": "workspace:*",
    "@ai-review/diff": "workspace:*",
    "@ai-review/llm": "workspace:*",
    "@ai-review/rag": "workspace:*",
    "@ai-review/report": "workspace:*",
    "@ai-review/shared": "workspace:*",
    "@ai-review/tools": "workspace:*",
    "@ai-sdk/openai": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "hono": "catalog:",
    "prom-client": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-review/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
